{
  "name": "@ardoiz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@ardoiz/source --env-file=../../.env src/app/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --conditions=@ardoiz/source --env-file-if-exists=../../.env src/platform/postgres/migrate-cli.ts"
  },
  "dependencies": {
    "@ardoiz/contracts": "0.0.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15"
  }
}
