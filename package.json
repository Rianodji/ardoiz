{
  "name": "ardoiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/contracts",
    "packages/content-schema",
    "apps/api",
    "apps/web",
    "tools/stubs/mermaid-to-excalidraw"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ardoiz/api & npm run dev --workspace @ardoiz/web & wait",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "vitest run --project api --project web --project contracts --project content-schema",
    "test:integration": "vitest run --project api-integration",
    "depcruise": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "licenses": "node tools/check-licenses.mjs",
    "db:migrate": "npm run db:migrate --workspace @ardoiz/api",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "ardoiz": "npm run cli --workspace @ardoiz/api --",
    "test:e2e": "npm run build -w @ardoiz/web && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "4.14.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.1",
      "@radix-ui/react-tabs": "1.1.13"
    }
  }
}
