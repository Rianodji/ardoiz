#!/bin/sh
# Détection de secrets avant chaque commit (R20). Activer une fois : git config core.hooksPath .githooks
set -eu
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --staged --redact --no-banner
fi
if command -v docker >/dev/null 2>&1; then
  exec docker run --rm -v "$(pwd):/repo" -w /repo \
    zricethezav/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f git --staged --redact --no-banner
fi
echo "gitleaks introuvable (ni binaire, ni Docker) : commit refusé (R20)." >&2
exit 1
